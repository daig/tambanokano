fmod INT-OFFSET-CONJ is
  sorts Zero Nat Neg Int Lit Conj .
  subsorts Zero < Nat Neg < Int .
  subsort Lit < Conj .
  op 0 : -> Zero [ctor] .
  op s : Nat -> Nat [ctor] .
  op p : Neg -> Neg [ctor] .
  op _=_ : Int Int -> Lit [ctor] .
  op _=/=_ : Int Int -> Lit [ctor] .
  op _/\_ : Lit Conj -> Conj [ctor] .

  var M : Nat . var N : Neg .  vars I J : Int .  

*** defined functions
  ops s p : Int -> Int .
  eq s(p(N)) = N [variant] .
  eq p(s(M)) = M [variant] .
endfm

