*** The prelude LIST-AND-SET shape: a module parameterized by X that protects both LIST{X} and SET{X}
*** by the enclosing parameter, with makeSet : List{X} -> Set{X} converting a list to a set (dropping
*** duplicates via the idempotent AC set union). Combines by-parameter instantiation, juxtaposition __,
*** an associative-commutative operator with identity, and a function over two parameterized containers.
fth TRIV is sort Elt . endfth
fmod NN is sort Nat . op 0 : -> Nat [ctor] . op s : Nat -> Nat [ctor] . endfm
view ToN from TRIV to NN is sort Elt to Nat . endv
fmod LIST{E :: TRIV} is
  sort List{E} .
  op nil : -> List{E} [ctor] .
  op __ : E$Elt List{E} -> List{E} [ctor] .
endfm
fmod SET{E :: TRIV} is
  sort Set{E} .
  op empty : -> Set{E} [ctor] .
  op _;_ : Set{E} Set{E} -> Set{E} [ctor assoc comm id: empty] .
  op {_} : E$Elt -> Set{E} [ctor] .
  var S : Set{E} .
  eq (S ; S) = S .
endfm
fmod LIST-AND-SET{X :: TRIV} is
  protecting LIST{X} .
  protecting SET{X} .
  op makeSet : List{X} -> Set{X} .
  var E : X$Elt .
  var L : List{X} .
  eq makeSet(nil) = empty .
  eq makeSet(E L) = ({E} ; makeSet(L)) .
endfm
fmod USE is protecting LIST-AND-SET{ToN} . endfm
red makeSet(nil) .
red makeSet(0 (s(0) nil)) .
red makeSet(0 (s(0) (0 nil))) .
