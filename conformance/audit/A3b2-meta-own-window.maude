*** PRELUDE
*** META up* own-statement window:
*** upEqs/upRls(_, false) must return ONLY the module's own statements (the LEADING slice of the
*** flattened vectors), with cross-module statement overlap present.
mod A3B2-BASE is
  sort St .
  ops a b c d : -> St [ctor] .
  op f : St -> St .
  eq f(a) = b .
  rl a => b .
endm

mod A3B2-EXT is
  including A3B2-BASE .
  eq f(c) = d .
  rl c => d .
endm

fmod A3B2-META is
  protecting META-LEVEL .
endfm

reduce in A3B2-META : upEqs('A3B2-EXT, false) .
reduce in A3B2-META : upRls('A3B2-EXT, false) .
*** The flat=true case uses rules so implicit BOOL injection cannot add equations and affect this fixture.
reduce in A3B2-META : upRls('A3B2-EXT, true) .
