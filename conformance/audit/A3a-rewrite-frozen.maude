*** A3a-rewrite-frozen — valid frozen traversal plus atomic recovery from invalid positions
mod FROZ is
  sort S .
  ops a b c d : -> S .
  op g : S -> S [frozen] .
  op h : S S -> S [frozen (2)] .
  rl a => b .
  eq c = d .
endm
rewrite in FROZ : g(a) .
rewrite in FROZ : h(a, a) .
rewrite in FROZ : g(c) .

mod BAD-FROZEN is
  sort S .
  ops a b : -> S .
  op f : S -> S [frozen (2)] .
  rl a => b .
endm
rewrite in BAD-FROZEN : f(a) .

mod BAD-FROZEN-ATOMIC is
  sort S .
  ops a b c d : -> S .
  op f : S S -> S [frozen (1 3)] .
  rl a => b .
  rl c => d .
endm
rewrite in BAD-FROZEN-ATOMIC : f(a, c) .
