*** PRELUDE
*** B5-graph-arcs — show search graph merges arcs differently and renders rule-text NAT literals differently
*** SG has two labelled rules r1, r2 that both rewrite a to f(2) — the same successor state. After the search,
*** show search graph prints on the oracle ONE merged arc listing both rules; tnk prints two separate arcs.
*** The rule text also diverges: the oracle renders the RHS as f(2), tnk as f(s s 0) (the state term f(2) agrees).
*** No comment line precedes the show command (that would trip a separate tnk command-parser bug).
mod SG is
  protecting NAT .
  sort St .
  op a : -> St .
  op f : Nat -> St .
  var X : St .
  rl [r1] : a => f(2) .
  rl [r2] : a => f(2) .
endm
search a =>* X .
show search graph .
