*** PRELUDE
*** B5-graph-arcs — show search graph arc merging and rule-text NAT literal rendering
*** SG has two labelled rules r1, r2 that both rewrite a to f(2) — the same successor state. After the search,
*** show search graph expected parity: ONE merged arc listing both rules.
*** Rule text expected parity: RHS rendered as f(2) (the state term f(2) agrees).
*** No comment line precedes the show command.
mod SG is
  protecting NAT .
  sort St .
  op a : -> St .
  op f : Nat -> St .
  var X : St .
  rl [r1] : a => f(2) .
  rl [r2] : a => f(2) .
endm
search a =>* X .
show search graph .
