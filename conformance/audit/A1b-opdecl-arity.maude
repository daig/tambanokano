*** A1b-opdecl-arity — declaration arity recovery: invalid mixfix arity and nonbinary assoc
*** Cases 1 and 2 preserve Maude's warning-and-recovery behavior for a mismatch between an operator
*** name's holes and its declared arity. Warnings are normalized by the harness; the
*** following commands prove that the invalid syntax cannot terminate the session.
fmod OPARITY is
  sort A .
  ops a b : -> A [ctor] .
  op _+_ : A A A -> A .
endfm
red in OPARITY : a + b .
red in OPARITY : a .

*** Case 2: 3-hole name declared unary. Maude disables the mixfix syntax while retaining the prefix
*** declaration; semantic recovery keeps the prefix form.
fmod OPUNARY is
  sort A .
  op a : -> A [ctor] .
  op _;_;_ : A -> A .
endfm
red in OPUNARY : a .

*** Case 3: assoc is meaningful only for a binary declaration. Maude clears the compiled
*** attribute and retains a free ternary operator; the nested command proves it is not AU-flattened.
fmod BAD-ASSOC is
  sort S .
  op a : -> S .
  op f : S S S -> S [assoc] .
endfm
red in BAD-ASSOC : f(a, a, a) .
red in BAD-ASSOC : f(a, a, f(a, a, a)) .
