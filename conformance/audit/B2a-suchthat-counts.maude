*** PRELUDE
*** B2a-suchthat-counts — `such that` condition-evaluation rewrites are not counted
*** Counter increments c(N); the bounded =>+ search keeps only odd N. Each solution's condition costs 2
*** extra rewrites for the `rem` and `=/=` reductions. Expected parity: per-solution rewrites 4/12/20;
*** states 2/4/6. The condition uses explicit `= true` so the search echo stays expected-parity.
mod COUNTER is
  protecting NAT .
  sort Ct .
  op c : Nat -> Ct [ctor] .
  var N : Nat .
  rl c(N) => c(N + 1) .
endm
search [3] c(0) =>+ c(N) such that N rem 2 =/= 0 = true .
