*** B1a-collapse-values — collapse-at-top under id: yields different VALUES, not just counts (fable-audit.md §3.2)
*** eq a <op> X = c fires by collapsing X to the identity, matching a lone `a` (with residue via extension).
*** ACU: red a -> c (oracle) vs a (tnk); red a + b -> b + c (oracle) vs c (tnk).
*** AU (assoc id:, no comm) and CUI (comm id:, no assoc) analogs diverge the same way.
*** §3.9.4: the collapse fires one-shot (ground `a` LHS keeps it terminating; no `eq X Y = c`/`red nil` shape).
fmod ACU-COLLAPSE is
  sort E .
  ops a b c e : -> E .
  op _+_ : E E -> E [assoc comm id: e] .
  var X : E .
  eq a + X = c .
endfm
red a .
red a + b .

fmod AU-COLLAPSE is
  sort E .
  ops a b c e : -> E .
  op _._ : E E -> E [assoc id: e] .
  var X : E .
  eq a . X = c .
endfm
red a .
red a . b .

fmod CUI-COLLAPSE is
  sort E .
  ops a b c e : -> E .
  op _*_ : E E -> E [comm id: e] .
  var X : E .
  eq a * X = c .
endfm
red a .
red a * b .
