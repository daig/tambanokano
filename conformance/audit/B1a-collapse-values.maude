*** B1a-collapse-values — collapse-at-top under id: yields different VALUES, not just counts
*** eq a <op> X = c fires by collapsing X to the identity, matching a lone `a` (with residue via extension).
*** ACU expected parity: red a -> c; red a + b -> b + c.
*** AU (assoc id:, no comm) and CUI (comm id:, no assoc) analogs follow the same shape.
*** The collapse fires one-shot (ground `a` LHS keeps it terminating; no `eq X Y = c`/`red nil` shape).
fmod ACU-COLLAPSE is
  sort E .
  ops a b c e : -> E .
  op _+_ : E E -> E [assoc comm id: e] .
  var X : E .
  eq a + X = c .
endfm
red a .
red a + b .

fmod AU-COLLAPSE is
  sort E .
  ops a b c e : -> E .
  op _._ : E E -> E [assoc id: e] .
  var X : E .
  eq a . X = c .
endfm
red a .
red a . b .

fmod CUI-COLLAPSE is
  sort E .
  ops a b c e : -> E .
  op _*_ : E E -> E [comm id: e] .
  var X : E .
  eq a * X = c .
endfm
red a .
red a * b .
