*** E2a-command-var-scope — variable aliases are module-local: a command in module M parses with M's
*** OWN var declarations, which take priority over any imported module's same-named variable —
*** fable-audit.md §3.10 E2. Pre-fix, prelude BOOL-OPS's Bool-sorted A B C, collected first by the
*** flatten, shadowed the module's own N-sorted A B C in the command grammar: reducing A typed it at
*** Bool, and reducing c applied to A and B failed to parse entirely.
*** PRELUDE
set show timing off .
fmod VARSCOPE is
  protecting BOOL .
  sort N .
  ops x y : -> N [ctor] .
  op c : N N -> N [ctor comm] .
  vars A B C : N .
endfm
red A .
red c(A, B) .
red c(A, B) == c(B, A) .
