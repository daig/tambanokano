*** E2a-command-var-scope — variable aliases are module-local: a command in module M parses with M's
*** OWN variable declarations, which take priority over any imported module's same-named variable.
*** Prelude BOOL-OPS also declares Bool-sorted A B C, so this fixture verifies that command grammar
*** resolution selects the module's N-sorted A B C instead.
*** PRELUDE
set show timing off .
fmod VARSCOPE is
  protecting BOOL .
  sort N .
  ops x y : -> N [ctor] .
  op c : N N -> N [ctor comm] .
  vars A B C : N .
endfm
red A .
red c(A, B) .
red c(A, B) == c(B, A) .
