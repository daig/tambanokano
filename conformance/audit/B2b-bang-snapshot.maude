*** PRELUDE
*** B2b-bang-snapshot — =>! per-solution snapshots: lazy exploration vs frontier-first expansion
*** Object level: M1 branches a=>{b,c}; b=>d (nf), c=>e=>f (nf). The FIRST =>! solution (d) prints
*** expected parity states: 5 rewrites: 4; totals (6/5) agree.
*** Meta level: metaSearch(['M1], ..., '!, ..., 0) expected parity rewrites: 6; result term identical.
*** The [Q] import-expression module form keeps the command echo clean.
mod M1 is
  sort St .
  ops a b c d e f : -> St .
  var X : St .
  rl a => b .
  rl a => c .
  rl b => d .
  rl c => e .
  rl e => f .
endm
search in M1 : a =>! X .

red in META-LEVEL : metaSearch(['M1], 'a.St, 'X:St, nil, '!, unbounded, 0) .
