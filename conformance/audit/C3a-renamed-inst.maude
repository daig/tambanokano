*** PRELUDE
*** C3a-renamed-inst — instantiating a renamed parameterized module
fmod M{X :: TRIV} is
  sort S .
  op wrap : X$Elt -> S [ctor] .
  op dup : X$Elt -> S .
  var E : X$Elt .
  eq dup(E) = wrap(E) .
endfm
view V from TRIV to NAT is
  sort Elt to Nat .
endv
fmod TEST is
  protecting (M * (sort S to T)){V} .
endfm
reduce in TEST : dup(0) .
