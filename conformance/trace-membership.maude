*** Full-trace fixture: membership-axiom steps. The trace shows the membership header, the mb body, the
*** substitution, then a sort narrowing line "oldSort: term becomes newSort" -- not a term rewrite. Two
*** memberships lower g(g(a)) from sort A: g(a) becomes B inner, g(g(a)) becomes C outer.
***   ~/Downloads/Maude-3/maude -no-banner conformance/trace-membership.maude < /dev/null
fmod MB-CHAIN is
  sorts A B C .
  subsorts C < B < A .
  op a : -> A [ctor] .
  op g : A -> A [ctor] .
  var X : A .
  mb g(X) : B .
  mb g(g(X)) : C .
endfm
set trace on .
red g(g(a)) .
