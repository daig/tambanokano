*** Pillar 2.5-A: object-message configurations under plain rewrite/search -- no erewrite, no IO.
*** Proves the build-layer plumbing for the OO operator attributes: `config`/`obj`/`portal` are
*** recorded onto the kernel symbol, and the `ObjectConstructorSymbol` id-hook on `<_:_|_>` resolves --
*** the object constructor is an ordinary free symbol; its third argument is the ACU `AttributeSet`.
*** CONFIGURATION is the real prelude module -- prelude.maude:3213, verbatim; the bank/ping-pong systems
*** are hand-written Core-Maude -- the omod/class desugaring is Phase 2.5-E. `set show advisories off`
*** suppresses the reference's "redefining module CONFIGURATION" advisory so the output is comparable.
***
*** Oracle -- byte-for-byte, modulo the `====`/`Bye.` framing:
***   ~/Downloads/Maude-3/maude -no-banner conformance/objects.maude < /dev/null

set show advisories off .

mod CONFIGURATION is
  sorts Attribute AttributeSet .
  subsort Attribute < AttributeSet .
  op none : -> AttributeSet  [ctor] .
  op _,_ : AttributeSet AttributeSet -> AttributeSet [ctor assoc comm id: none] .

  sorts Oid Cid Object Msg Portal Configuration .
  subsort Object Msg Portal < Configuration .
  op <_:_|_> : Oid Cid AttributeSet -> Object [ctor object
                                               special (
                                                 id-hook ObjectConstructorSymbol
						 op-hook attributeSetSymbol (_,_ : AttributeSet AttributeSet ~> AttributeSet))] .
  op none : -> Configuration [ctor] .
  op __ : Configuration Configuration -> Configuration [ctor config assoc comm id: none] .
  op <> : -> Portal [ctor portal] .

  op getClass : Object -> Cid .
  eq getClass(< O:Oid : C:Cid | A:AttributeSet >) = C:Cid .
endm

*** A minimal real NAT (the prelude's `s_`/`_+_` slice: SuccSymbol + ACU_NumberOpSymbol). Two `_+_`
*** declarations keep it associative on every sort triple (the second is `[ditto]`).
fmod NAT is
  sorts Zero NzNat Nat .
  subsort Zero NzNat < Nat .
  op 0 : -> Zero [ctor] .
  op s_ : Nat -> NzNat [ctor iter special (id-hook SuccSymbol term-hook zeroTerm (0))] .
  op _+_ : NzNat Nat -> NzNat [assoc comm prec 33 special (id-hook ACU_NumberOpSymbol (+) op-hook succSymbol (s_ : Nat ~> NzNat))] .
  op _+_ : Nat Nat -> Nat [ditto] .
endfm

mod BANK is
  protecting CONFIGURATION .
  protecting NAT .
  sort AccId .
  subsort AccId < Oid .
  op Account : -> Cid [ctor] .
  op bal :_ : Nat -> Attribute [ctor] .
  ops a b : -> AccId [ctor] .
  op credit : Oid Nat -> Msg [ctor msg] .
  var A : AccId .  vars N M : Nat .
  rl [credit] : credit(A, M) < A : Account | bal : N > => < A : Account | bal : (N + M) > .
endm

mod PINGPONG is
  protecting CONFIGURATION .
  protecting NAT .
  sort PlayerId .
  subsort PlayerId < Oid .
  op Player : -> Cid [ctor] .
  op turns :_ : Nat -> Attribute [ctor] .
  ops p1 p2 : -> PlayerId [ctor] .
  ops ping pong : Oid Oid -> Msg [ctor msg] .
  vars X Y : Oid .  var N : Nat .
  rl [ping] : ping(X, Y) < X : Player | turns : N > => pong(Y, X) < X : Player | turns : (s N) > .
  rl [pong] : pong(X, Y) < X : Player | turns : N > => ping(Y, X) < X : Player | turns : (s N) > .
endm

rewrite in BANK : < a : Account | bal : 0 > < b : Account | bal : 100 > credit(a, 50) credit(b, 25) .
red in BANK : getClass(< a : Account | bal : 0 >) .
search in BANK : < a : Account | bal : 0 > credit(a, 5) credit(a, 7) =>* < a : Account | bal : N > .
rewrite [4] in PINGPONG : ping(p1, p2) < p1 : Player | turns : 0 > < p2 : Player | turns : 0 > .
search [1] in PINGPONG : ping(p1, p2) < p1 : Player | turns : 0 > < p2 : Player | turns : 0 > =>+ pong(p2, p1) C:Configuration .

*** Pillar 2.5-B: erewrite (object-message-fair). The `msg`-flagged credit/ping/pong engage the
*** ConfigSymbol scheduler. One pass delivers every queued message object-by-object (oid order); the
*** [n] bound counts delivering passes -- bank delivers both credits in one pass, ping-pong one per pass.
erewrite in BANK : < a : Account | bal : 0 > < b : Account | bal : 100 > credit(a, 50) credit(b, 25) .
erewrite in BANK : < a : Account | bal : 0 > credit(a, 5) credit(a, 7) .
erewrite [3] in PINGPONG : ping(p1, p2) < p1 : Player | turns : 0 > < p2 : Player | turns : 0 > .
