*** B2.4 evaluation-strategy (strat) conformance vs the reference binary:
***   ~/Downloads/Maude-3/maude -no-banner conformance/strat.maude < /dev/null
*** strat (1 0) on if_then_else_fi reduces the condition, then the top — the unused branch is NOT
*** reduced. Mirrors the engine.rs B2.4 tests.

fmod STRAT is
  sorts Nat Truth .
  ops tt ff : -> Truth [ctor] .
  op z : -> Nat [ctor] .
  op s_ : Nat -> Nat [ctor] .
  op big : -> Nat .
  op if_then_else_fi : Truth Nat Nat -> Nat [strat (1 0)] .
  vars X Y : Nat .
  eq big = s s z .
  eq if tt then X else Y fi = X .
  eq if ff then X else Y fi = Y .
endfm
red big .                          *** s s z (1 rewrite — sanity)
red if tt then z else big fi .     *** z, 1 rewrite: the else branch `big` is never reduced
red if ff then big else z fi .     *** z, 1 rewrite: the then branch `big` is never reduced
red if tt then big else z fi .     *** s s z, 2 rewrites: the chosen branch `big` IS reduced
