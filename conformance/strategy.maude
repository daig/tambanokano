*** Core strategy combinators against Maude's `srewrite` and `dsrewrite`.
mod STRAT-CORE is
  sort S .
  ops a b c d : -> S [ctor] .
  rl [r1] : a => b .
  rl [r2] : a => c .
  rl [r3] : b => d .
  rl [r4] : c => d .
endm
srewrite a using r1 .
srewrite a using r1 | r2 .
srewrite a using r1 ; r3 .
srewrite a using r1 * .
srewrite a using all .
srewrite a using idle .
srewrite a using fail .
srewrite a using top(r1) .
srewrite a using match b .
srewrite a using match a .
srewrite a using amatch d .
srewrite a using r1 ? r3 : r2 .
srewrite a using r2 ? r3 : r4 .
srewrite a using (r1 | r2) ! .
srewrite a using r1 + .
srewrite a using try(r1) .
srewrite a using not(fail) .
srewrite a using (r1 ; r3) | (r2 ; r4) .
srewrite a using one(r1 | r2) .
dsrewrite a using r1 | r2 .
dsrewrite a using (r1 | r2) ; r3 .

*** Named and recursive strategy definitions, including depth-first multi-solution calls.
smod STRAT-DEFS is
  protecting STRAT-CORE .
  strats go go2 reach : @ S .
  sd go := r1 ; r3 .
  sd go2 := go | r2 .
  sd reach := idle | ((r1 | r2 | r3 | r4) ; reach) .
endsm
srewrite a using go .
dsrewrite a using go2 .
dsrewrite a using reach .

*** Match-rewrite forms, conditional-rule substrategies, application substitutions, `xmatch`, and
*** parameterized strategy calls.
mod STRAT-D is
  sort S .
  ops a b c d : -> S [ctor] .
  op f : S S -> S [ctor] .
  op g : S -> S [ctor] .
  rl [r1] : a => b .
  rl [r2] : a => c .
  rl [swap] : f(X:S, Y:S) => f(Y:S, X:S) .
  crl [wrap] : a => g(Z:S) if a => Z:S .    *** a rewrite (`=>`) condition — needs a substrategy
  crl [eqc] : a => d if b = b .             *** an equality condition that holds
  crl [eqf] : a => d if b = c .             *** an equality condition that fails
endm
srewrite f(a, a) using matchrew f(X:S, Y:S) by X:S using r1, Y:S using r2 .
srewrite f(a, a) using matchrew f(X:S, Y:S) by X:S using (r1 | r2), Y:S using r1 .
dsrewrite f(a, a) using matchrew f(X:S, Y:S) by X:S using (r1 | r2), Y:S using (r1 | r2) .
srewrite f(a, a) using matchrew f(X:S, Y:S) by X:S using r1 .
srewrite f(b, a) using matchrew f(X:S, Y:S) by X:S using r1, Y:S using r2 .
srewrite f(a, a) using amatchrew X:S by X:S using r1 .
srewrite a using wrap{r1} .
srewrite a using wrap{r2} .
dsrewrite a using wrap{r1 | r2} .
srewrite a using wrap .
srewrite a using eqc .
srewrite a using eqf .
srewrite f(a, b) using swap .
srewrite f(a, b) using swap[X:S <- a] .
srewrite f(a, b) using swap[X:S <- b] .

*** xmatch (extension) test over an associative operator — a test returns the (unchanged) subject.
mod STRAT-XM is
  sort S .
  op _._ : S S -> S [ctor assoc] .
  ops a b : -> S [ctor] .
endm
srewrite a . a . a using xmatch X:S . Y:S .
srewrite a . a . a using match X:S . Y:S .

*** Parameterized strategy calls (`sd s(p) := …`), incl. a parameter used inside a pattern bubble.
smod STRAT-DP is
  protecting STRAT-D .
  strat s2 mtest : S @ S .
  strat go3 : @ S .
  sd s2(W:S) := r1 .
  sd go3 := s2(a) .
  sd mtest(T:S) := match T:S .
endsm
srewrite a using s2(a) .
srewrite a using go3 .
srewrite b using mtest(b) .
srewrite b using mtest(a) .
