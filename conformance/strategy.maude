*** Phase 2.4 — strategy language (core combinators). Oracle: the reference binary's srewrite/dsrewrite.
*** Solution values + order are byte-identical; the per-solution srewrite rewrite count follows the BFS
*** snapshot (see gaps.md), so the test pins the solution values/structure.
mod STRAT-CORE is
  sort S .
  ops a b c d : -> S [ctor] .
  rl [r1] : a => b .
  rl [r2] : a => c .
  rl [r3] : b => d .
  rl [r4] : c => d .
endm
srewrite a using r1 .
srewrite a using r1 | r2 .
srewrite a using r1 ; r3 .
srewrite a using r1 * .
srewrite a using all .
srewrite a using idle .
srewrite a using fail .
srewrite a using top(r1) .
srewrite a using match b .
srewrite a using match a .
srewrite a using amatch d .
srewrite a using r1 ? r3 : r2 .
srewrite a using r2 ? r3 : r4 .
srewrite a using (r1 | r2) ! .
srewrite a using r1 + .
srewrite a using try(r1) .
srewrite a using not(fail) .
srewrite a using (r1 ; r3) | (r2 ; r4) .
srewrite a using one(r1 | r2) .
dsrewrite a using r1 | r2 .
dsrewrite a using (r1 | r2) ; r3 .

*** Strategy definitions (sd) + calls (Phase C). `dsrewrite` for multi-solution calls — its depth-first
*** order/count is faithful; the fair `srewrite` BFS order for unequal-depth branches is a follow-on (gaps.md).
smod STRAT-DEFS is
  protecting STRAT-CORE .
  strats go go2 reach : @ S .
  sd go := r1 ; r3 .
  sd go2 := go | r2 .
  sd reach := idle | ((r1 | r2 | r3 | r4) ; reach) .
endsm
srewrite a using go .
dsrewrite a using go2 .
dsrewrite a using reach .
