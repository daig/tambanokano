*** Full-trace fixture: a user equation step. The trace shows the equation header, the eq body via the
*** Term printer, the variable substitution, then the redex and its result.
fmod PEANO is
  sort Nat .
  op 0 : -> Nat [ctor] .
  op s_ : Nat -> Nat [ctor] .
  op _+_ : Nat Nat -> Nat .
  vars N M : Nat .
  eq N + 0 = N .
  eq N + s M = s (N + M) .
endfm
set trace on .
red s 0 + s 0 .
