*** V1 honest-behavior binary smoke: count-only output, explicit unsupported diagnostics, and recovery.
set show timing off .
set show timing on .
set show timing off .
smod V1-SMOKE is
  sort S .
  ops a b c : -> S [ctor] .
  op f : S -> S [memo] .
  var X : S .
  eq f(X) = X [print Y] .
  eq f(a) = b .
  rl [r] : b => c .
  strats sx ok : @ S .
  sd sx := xmatchrew Z:S by Z using r .
  sd ok := r .
endsm
red in V1-SMOKE : f(a) .
set clear memo on .
red in V1-SMOKE : f(a) .
do clear memo V1-SMOKE .
red in V1-SMOKE : f(a) .
srewrite in V1-SMOKE : b using sx .
srewrite in V1-SMOKE : b using ok .
smod V1-SMOKE is
  sort S .
  op a : -> Missing [ctor] .
endsm
red in V1-SMOKE : f(a) .
view BAD from V1-SMOKE to V1-SMOKE is endv
red in V1-SMOKE : f(a) .
