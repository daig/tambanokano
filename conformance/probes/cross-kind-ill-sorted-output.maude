*** COV-002 / OUT-003 retained probe: context-free selection picks the first range-kind profile.
*** Maude prints the resulting ill-sorted application with `.B`; tnk currently prints `.[B]`.
*** This file is intentionally outside exact-parity scoreboards until OUT-003 is classified.

set show timing off .
fmod COV002-ILL-SORTED-OUTPUT is
  sorts A A1 A2 B C .
  subsorts A1 A2 < A .
  op a1 : -> A1 [ctor] .
  op a2 : -> A2 [ctor] .
  op b : -> B [ctor] .
  op f : A1 -> B .
  op f : A2 -> C .
  eq (f(a1)).B = b .
endfm
red in COV002-ILL-SORTED-OUTPUT : f(a1) .
red in COV002-ILL-SORTED-OUTPUT : f(a2) .
