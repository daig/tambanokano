*** PRELUDE
*** Direct Maude 3.5.1 / tnk boundary probe for the V1 honest-behavior goal.
*** Expected classification (2026-07-29):
*** - ordinary metaMatch and proper-residue metaXmatch/metaXapply below match the oracle;
*** - conditioned metaMatch/metaXmatch remain unreduced in tnk;
*** - conditional-rule metaApply/metaXapply remain unreduced instead of evaluating the condition;
*** - partial AC patterns headed by the subject's AC symbol are not oracle-compatible in tnk;
*** - strategy META parse/print remain unreduced in tnk;
*** - upModule drops source memo, while a literal reflected memo module reduces with the attribute inert.
set show timing off .
set show advisories off .

fmod META-BOUNDARY-MATCH is
  sort S .
  ops a b c d : -> S [ctor] .
  op f : S S -> S [ctor assoc comm] .
endfm

mod META-BOUNDARY-CONDITIONAL is
  sort S .
  ops a b : -> S [ctor] .
  op f : S S -> S [ctor comm] .
  vars X Y Z : S .
  crl [r] : f(X, a) => Y if f(Y, Z) := f(a, b) .
endm

mod META-BOUNDARY-RESIDUE is
  sort S .
  ops a b c d : -> S [ctor] .
  op f : S S -> S [ctor assoc comm] .
  rl [r] : a => d .
endm

mod META-BOUNDARY-PARTIAL-AC is
  sort S .
  ops a b c d : -> S [ctor] .
  op f : S S -> S [ctor assoc comm] .
  vars X Y : S .
  rl [r] : f(X, Y) => d .
endm

fmod META-BOUNDARY-MEMO is
  sort N .
  op z : -> N [ctor] .
  op f : N -> N [memo] .
  eq f(z) = z .
endfm

*** Supported ordinary and proper-residue operations.
red in META-LEVEL : metaMatch(upModule('META-BOUNDARY-MATCH, false), 'X:S, 'a.S, nil, 0) .
red in META-LEVEL : metaXmatch(upModule('META-BOUNDARY-MATCH, false), 'a.S, 'f['a.S, 'b.S, 'c.S], nil, 0, unbounded, 0) .
red in META-LEVEL : metaXapply(upModule('META-BOUNDARY-RESIDUE, false), 'f['a.S, 'b.S, 'c.S], 'r, none, 0, unbounded, 0) .

*** Unsupported conditioned operations.
red in META-LEVEL : metaMatch(upModule('META-BOUNDARY-MATCH, false), 'X:S, 'a.S, 'f['Y:S, 'Z:S] := 'f['a.S, 'b.S], 0) .
red in META-LEVEL : metaXmatch(upModule('META-BOUNDARY-MATCH, false), 'X:S, 'a.S, 'f['Y:S, 'Z:S] := 'f['a.S, 'b.S], 0, unbounded, 0) .
red in META-LEVEL : metaApply(upModule('META-BOUNDARY-CONDITIONAL, false), 'f['a.S, 'a.S], 'r, none, 0) .
red in META-LEVEL : metaXapply(upModule('META-BOUNDARY-CONDITIONAL, false), 'f['f['a.S, 'a.S], 'b.S], 'r, none, 0, unbounded, 0) .

*** Unsupported partial-AC whole-pattern semantics (compare bindings, values, and contexts).
red in META-LEVEL : metaXmatch(upModule('META-BOUNDARY-PARTIAL-AC, false), 'f['X:S, 'Y:S], 'f['a.S, 'b.S, 'c.S], nil, 0, unbounded, 0) .
red in META-LEVEL : metaXapply(upModule('META-BOUNDARY-PARTIAL-AC, false), 'f['a.S, 'b.S, 'c.S], 'r, none, 0, unbounded, 0) .

*** Inert strategy META hooks.
red in META-LEVEL : metaParseStrategy(['NAT], none, 'top '`( 'all '`)) .
red in META-LEVEL : metaPrettyPrintStrategy(['NAT], none, top(all), mixfix) .

*** Reflected memo boundaries.
red in META-LEVEL : upModule('META-BOUNDARY-MEMO, false) .
red in META-LEVEL : metaReduce(fmod 'META-BOUNDARY-LITERAL-MEMO is
  including 'BOOL .
  sorts 'N .
  none
  op 'f : 'N -> 'N [memo strat(1 0)] .
  op 'z : nil -> 'N [ctor] .
  none
  eq 'f['z.N] = 'z.N [none] .
  none
endfm, 'f['z.N]) .
