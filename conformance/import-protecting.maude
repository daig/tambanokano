*** Module-system conformance: `protecting` a base module, then using both signatures.
fmod NAT0 is
  sort N .
  op 0 : -> N [ctor] .
  op s : N -> N [ctor] .
  op add : N N -> N .
  vars X Y : N .
  eq add(0, Y) = Y .
  eq add(s(X), Y) = s(add(X, Y)) .
endfm

fmod DOUBLE is
  protecting NAT0 .
  op double : N -> N .
  var X : N .
  eq double(X) = add(X, X) .
endfm

red double(s(s(0))) .   *** add(2,2) = 4
red add(s(0), double(s(s(s(0))))) .   *** 1 + double(3) = 1 + 6 = 7
