*** Structure sharing (construction dedup + normal-form forwarding).
***
*** The subject (and an equation's rhs) is a hash-consed DAG, so a REPEATED reducible
*** subterm is one shared node, reduced ONCE. Two halves: construction-time structural dedup
*** first creates one shared node; normal-form forwarding then redirects that node to its
*** result instead of re-reducing it. Counts below guard against duplicate reduction.

fmod FREE-SHARE is
  sorts E P .
  ops a b c : -> E [ctor] .
  op g : E -> E .
  op <_,_> : E E -> P [ctor] .
  op h : E E E -> P .
  op f : E -> P .
  var X : E .
  eq g(a) = b .
  eq g(b) = c .
  eq f(X) = < g(X), g(X) > .
  eq h(X, X, X) = < X, X > .
endfm
*** Subject duplicate under a free op: the two g(a) dedup to one node, reduced once.
red < g(a), g(a) > .          *** P: < b, b >, 1 rewrite
*** Deep shared chain: each shared g(g(a)) is g(a)->b->... no: g(g(a)) -> g(b) -> c is 2 rewrites,
*** done once for the shared node.
red < g(g(a)), g(g(a)) > .    *** P: < c, c >, 2 rewrites
*** RHS duplicate: f(a) fires [1], then its rhs < g(a), g(a) > shares the g(a) duplicate -> reduced
*** once [2] (Maude's RhsBuilder CSE).
red f(a) .                    *** P: < b, b >, 2 rewrites
*** Triple subject duplicate: g(a)->b once [1], then h(b,b,b) -> < b, b > [2].
red h(g(a), g(a), g(a)) .     *** P: < b, b >, 2 rewrites

fmod MB-SHARE is
  sorts Sml Big P .
  subsort Sml < Big .
  op mkA : -> Big [ctor] .
  op <_,_> : Big Big -> P [ctor] .
  mb mkA : Sml .
endfm
*** The shared `mkA` node receives its membership once at normal form.
red < mkA, mkA > .            *** P: < mkA, mkA >, 1 rewrite

fmod AU-SHARE is
  sorts E L .
  subsort E < L .
  ops a b : -> E [ctor] .
  op g : E -> E .
  op __ : L L -> L [assoc] .
  var X : E .
  eq g(a) = b .
endfm
*** Repeated element under an associative (non-comm) op: the equal g(a) elements dedup to one node,
*** reduced once rather than once per occurrence.
red g(a) g(a) .               *** L: b b, 1 rewrite
red g(a) g(a) g(a) .          *** L: b b b, 1 rewrite

fmod CUI-SHARE is
  sorts E .
  ops a b : -> E [ctor] .
  op g : E -> E .
  op _&_ : E E -> E [comm] .
  var X : E .
  eq g(a) = b .
endfm
*** Repeated element under a commutative (non-assoc) op: the two g(a) dedup and reduce once.
red g(a) & g(a) .             *** E: b & b, 1 rewrite

fmod ACU-SHARE is
  sorts E .
  ops a b : -> E [ctor] .
  op g : E -> E .
  op _+_ : E E -> E [assoc comm] .
  var X : E .
  eq g(a) = b .
endfm
*** Sanity: under AC a duplicate already merges to one element with multiplicity 2 (reduced once) —
*** Structure sharing leaves this case unchanged. Result keeps both copies: b + b.
red g(a) + g(a) .             *** E: b + b, 1 rewrite
