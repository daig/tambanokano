*** A user-typed colon variable over a structured (parameterized-style) sort, L:List{Nat}, written inline
*** in an equation and a match command. The braces are part of the one-token variable, so it resolves to a
*** variable of sort List{Nat}.
fmod M is
  sorts Nat List{Nat} .
  op 0 : -> Nat [ctor] .
  op nil : -> List{Nat} [ctor] .
  op c : Nat List{Nat} -> List{Nat} [ctor] .
  op hd : List{Nat} -> List{Nat} .
  eq hd(c(N:Nat, L:List{Nat})) = L:List{Nat} .
endfm
red hd(c(0, c(0, nil))) .
red hd(nil) .
