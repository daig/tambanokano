*** Variable aliases are module-local. M imports P, and both declare A at different sorts: A is S in P
*** and T in M. M's equation f(A, L) = A L must use A:T even though flattening sees P's A:S first.
*** The fixture verifies that flattening preserves the declaration's module scope.
*** The stock LIST case has `A : List{X}` shadowed by BOOL-OPS' `A B C : Bool` reached through
*** protecting NAT then BOOL then BOOL-OPS. Each module's statements still reduce with its own A.
***
*** Variable aliases remain module-local under stock LIST import as well.

fmod P is
  sort S .
  op a : -> S [ctor] .
  op g : S -> S .
  var A : S .
  eq g(A) = A .
endfm

fmod M is
  protecting P .
  sort T .
  op e : -> T [ctor] .
  op nil : -> T [ctor] .
  op __ : T T -> T [ctor assoc id: nil] .
  op f : T T -> T .
  var A L : T .
  eq f(A, L) = A L .
endfm

red f(e, e) .
red f(nil, e) .
red g(a) .
