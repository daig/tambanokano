*** B5: a diamond import — TOP imports LEFT and RIGHT, both protecting BASE; BASE included exactly once.
fmod BASE is
  sort N .
  op 0 : -> N [ctor] .
  op s : N -> N [ctor] .
  op add : N N -> N .
  vars X Y : N .
  eq add(0, Y) = Y .
  eq add(s(X), Y) = s(add(X, Y)) .
endfm

fmod LEFT is
  protecting BASE .
  op dbl : N -> N .
  var X : N .
  eq dbl(X) = add(X, X) .
endfm

fmod RIGHT is
  protecting BASE .
  op tpl : N -> N .
  var X : N .
  eq tpl(X) = add(X, add(X, X)) .
endfm

fmod TOP is
  protecting LEFT .
  protecting RIGHT .
  op combine : N -> N .
  var X : N .
  eq combine(X) = add(dbl(X), tpl(X)) .   *** 2X + 3X = 5X
endfm

red combine(s(0)) .   *** 5
