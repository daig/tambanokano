*** Built-in seam conformance against stock Maude.
*** EqualitySymbol _~_ and BranchSymbol myif are bound monomorphically via id-hooks. `myif` is lazy:
*** its dead branch is not reduced. Polymorphic hook expansion has separate BOOL fixtures.
fmod BOOLB is
  sorts Truth Zero NzNat Nat .
  subsorts Zero NzNat < Nat .
  ops tt ff : -> Truth [ctor] .
  op 0 : -> Zero [ctor] .
  op s_ : Nat -> NzNat [ctor iter] .
  op big : -> Nat .
  eq big = s s 0 .
  op myif : Truth Nat Nat -> Nat
        [special (id-hook BranchSymbol term-hook 1 (tt) term-hook 2 (ff))] .
  op _~_ : Nat Nat -> Truth
        [special (id-hook EqualitySymbol term-hook equalTerm (tt) term-hook notEqualTerm (ff))] .
endfm
red (s s 0) ~ (s s 0) .     *** tt    (1 rewrite)
red (s s 0) ~ (s s s 0) .   *** ff    (1 rewrite)
red 0 ~ 0 .                 *** tt    (1 rewrite)
red myif(tt, 0, big) .      *** 0     (1 rewrite — dead `big` unreduced)
red myif(tt, big, 0) .      *** s s 0 (2 rewrites — chosen branch reduced)
red myif(ff, big, 0) .      *** 0     (1 rewrite — dead `big` unreduced)
