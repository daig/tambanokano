*** A view maps theory TRIV to module NUM. Before instantiation, the view is validated and stored while
*** the target module reduces normally. This pins end-to-end loading of a file carrying a valid view.
fth TRIV is
  sort Elt .
endfth

fmod NUM is
  sort N .
  op z : -> N [ctor] .
  op s : N -> N [ctor] .
  op p : N -> N .
  var X : N .
  eq p(s(X)) = X .
endfm

view ToNum from TRIV to NUM is
  sort Elt to N .
endv

red p(s(z)) .       *** z (1 rewrite)
red p(s(s(z))) .    *** s(z) (1 rewrite)
