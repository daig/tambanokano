*** Conditional rules with equality, matching, and sort-test condition fragments.
*** Rewrite conditions are covered separately. Rate normalized.
***
***   f(a) -> g(a)   first crl fires: equality `X = a` holds (X bound to a)
***   f(b) -> h(b)   first crl fails (b =/= a), backtracks; second crl `Y := b` binds Y and fires
***   k(a) -> g(a)   sort-test `X : T` holds (a has sort T)
***   k(b) -> k(b)   sort-test fails (b is S, not T); no other k rule -> 0 rewrites

mod CRL is
  sorts T S .
  subsort T < S .
  op a : -> T .
  op b : -> S .
  ops f g h k : S -> S [ctor] .
  vars X Y : S .
  crl f(X) => g(X) if X = a .
  crl f(X) => h(Y) if Y := X .
  crl k(X) => g(X) if X : T .
endm

rewrite f(a) .
rewrite f(b) .
rewrite k(a) .
rewrite k(b) .
