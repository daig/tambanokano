*** M10-sat-taut — model/false/true/counterexample and prime-implicant rendering
*** Includes all three executable Maude manual §12.4 examples plus five minimal probes.
*** PRELUDE
set show timing off .
load model-checker

fmod M-SAT-CHECK is
  extending SAT-SOLVER .
  extending LTL .
  ops a b c d e p q r : -> Formula [ctor] .
endfm

*** Minimal sibling-surface probes.
*** Freeze SatSolverSymbol's own verbose statistics, including singular/plural/zero forms.
set verbose on .
red in M-SAT-CHECK : satSolve(True) .
red in M-SAT-CHECK : satSolve(a U b) .
set verbose off .
red in M-SAT-CHECK : satSolve(a /\ ~ a) .
red in M-SAT-CHECK : tautCheck(a -> a) .
red in M-SAT-CHECK : tautCheck([] a -> a) .

*** Maude manual §12.4: nontrivial model and both tautology outcomes.
red in M-SAT-CHECK : satSolve(a /\ (O b) /\ (O O ((~ c) /\ [](c \/ (O c))))) .
red in M-SAT-CHECK : tautCheck((a => (O a)) <-> (a => ([] a))) .
red in M-SAT-CHECK : tautCheck((a -> (O a)) <-> (a -> ([] a))) .
