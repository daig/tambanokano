*** ch14-05-abelian-group — Lankford's Abelian group presentation (AC + 10 variant equations): 47 variants for _+_, 4 for -_ (Maude manual §14.4)

fmod ABELIAN-GROUP is
 sorts Element .
 op _+_ : Element Element -> Element [comm assoc prec 30] .
 op -_ : Element -> Element [prec 20] .
 op 0 : ->  Element .
 vars X Y Z : Element  .
 eq X + 0 = X [variant] .
 eq X + - X = 0 [variant] .
 eq X + - X + Y = Y [variant] .
 eq - - X = X [variant] .
 eq - 0 = 0 [variant] .
 eq - X + - Y = -(X + Y) [variant] .
 eq -(X + Y) + Y = - X [variant] .
 eq -(- X + Y) = X + - Y [variant] .
 eq - X + - Y + Z  = -(X + Y) + Z [variant] .
 eq -(X + Y) + Y + Z = - X + Z [variant] .
endfm

*** §14.4: 47 irredundant variants (manual shows 1, 2, 46, 47)
get irredundant variants in ABELIAN-GROUP : X + Y .

*** §14.4: 4 irredundant variants of the minus symbol
get irredundant variants in ABELIAN-GROUP : - X .
