*** Parameterized views and renaming of structured sorts parse, instantiate, and reduce.
*** Covers the `LIST{Qid}`/`NeList{Qid}` shape used by the built-in module chain.

fth ELT is sort Elt . endfth

fmod COLOR is
  sort Color .
  ops red green blue : -> Color [ctor] .
endfm

view ColorE from ELT to COLOR is
  sort Elt to Color .
endv

fmod BOX{X :: ELT} is
  sort Box{X} .
  op b : X$Elt X$Elt -> Box{X} [ctor comm] .
endfm

*** a parameterized view whose target is the module expression BOX{X} (the `to M{X}` decl parses)
view Boxed{X :: ELT} from ELT to BOX{X} is
  sort Elt to Box{X} .
endv

*** simple instantiation + a structured-sort renaming (the renaming() sort_name handling — the QID-LIST unblock)
fmod COLOR-BOX is
  protecting BOX{ColorE} * (sort Box{ColorE} to ColorBox) .
endfm

red in COLOR-BOX : b(red, green) .
red in COLOR-BOX : b(green, red) .
