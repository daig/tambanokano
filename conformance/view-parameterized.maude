*** The view-gap parser fix, self-contained (both engines run this file directly — no prelude clash):
*** a parameterized view declaration (`view V{X :: T} from T to M{X}`) and a renaming over a STRUCTURED
*** sort (`* (sort Box{ColorE} to ColorBox)`) both parse, so a parameterized module instantiated on a
*** view + renamed builds and reduces. Same pattern QID-LIST uses on the builtin chain:
*** protecting LIST{Qid} renamed by `sort NeList{Qid} to NeQidList`. Oracle: this file through Maude 3.

fth ELT is sort Elt . endfth

fmod COLOR is
  sort Color .
  ops red green blue : -> Color [ctor] .
endfm

view ColorE from ELT to COLOR is
  sort Elt to Color .
endv

fmod BOX{X :: ELT} is
  sort Box{X} .
  op b : X$Elt X$Elt -> Box{X} [ctor comm] .
endfm

*** a parameterized view whose target is the module expression BOX{X} (the `to M{X}` decl parses)
view Boxed{X :: ELT} from ELT to BOX{X} is
  sort Elt to Box{X} .
endv

*** simple instantiation + a structured-sort renaming (the renaming() sort_name fix — the QID-LIST unblock)
fmod COLOR-BOX is
  protecting BOX{ColorE} * (sort Box{ColorE} to ColorBox) .
endfm

red in COLOR-BOX : b(red, green) .
red in COLOR-BOX : b(green, red) .
